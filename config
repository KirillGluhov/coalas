[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
	worktree = .
[remote "origin"]
	url = https://github.com/KirillGluhov/coalas.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "master"]
	remote = origin
	merge = refs/heads/master
[branch "rn"]
	remote = origin
	merge = refs/heads/rn
[branch "back"]
	remote = origin
	merge = refs/heads/back
[branch "mob"]
	remote = origin
	merge = refs/heads/mob
